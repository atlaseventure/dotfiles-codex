# 按当前账户可用模型调整。
model = "gpt-5.6-sol"
model_reasoning_effort = "high"
disable_response_storage = true
personality = "pragmatic"

[windows]
sandbox = "unelevated"

[model_providers.custom]
name = "OpenAI"
wire_api = "responses"
requires_openai_auth = true
# supports_websockets = true
base_url = "https://api.openai.com/v1"

[mcp_servers.ida-windows]
command = "/windows/path/to/uv.exe"
args = ["run", "--directory", '\path\to\ida-pro-mcp', "--locked", "idalib-mcp", "--stdio"]

# 按当前账户可用模型调整。
model = "gpt-6.1-sol"
model_reasoning_effort = "high"
personality = "pragmatic"

[windows]
sandbox = "unelevated"

[model_providers.custom]
name = "OpenAI"
wire_api = "responses"
requires_openai_auth = true
# supports_websockets = true
base_url = "https://api.openai.com/v1"
experimental_bearer_token = "apikey"
